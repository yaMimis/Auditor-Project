<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Auditor" targetNamespace="http://auditor-preco-justo/bpmn" exporter="Auditor de Preco Justo" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Auditor">
    <bpmn:participant id="Participant_Contrato" name="Auditor de Preço Justo: avaliação de um contrato" processRef="Process_Contrato" />
    <bpmn:participant id="Participant_Equidade" name="Auditoria de equidade da carteira (em lote)" processRef="Process_Equidade" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Contrato" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Contrato">
      <bpmn:lane id="Lane_Sistema" name="Sistema e motor de regras (FastAPI)">
        <bpmn:flowNodeRef>Start_Contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Juro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Comparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Margem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SemIndicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conferir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Numeros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Template</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Junta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recomendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Recomendacao</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IA" name="Motor de IA e RAG (LangChain, pgvector)">
        <bpmn:flowNodeRef>Task_Normas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Parecer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista" name="Analista de crédito (Streamlit)">
        <bpmn:flowNodeRef>Task_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decisao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Mantido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Compliance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Contrato" name="Contrato recebido para auditoria">
      <bpmn:outgoing>Flow_Start_PD</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_PD" name="Calcular a PD e a faixa de risco">
      <bpmn:documentation>Modelo de risco (XGBoost calibrado). Devolve probabilidade de default, faixa e motivos (SHAP) pelo prever().</bpmn:documentation>
      <bpmn:incoming>Flow_Start_PD</bpmn:incoming>
      <bpmn:outgoing>Flow_PD_Juro</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Juro" name="Calcular o juro justo e a margem de incerteza">
      <bpmn:documentation>Preço por fluxo de caixa: custo do dinheiro (Euribor do mês da concessão, piso em zero), perda esperada, custos e margem calibrados na carteira.</bpmn:documentation>
      <bpmn:incoming>Flow_PD_Juro</bpmn:incoming>
      <bpmn:outgoing>Flow_Juro_Comparar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Comparar" name="Comparar o juro cobrado com o justo">
      <bpmn:documentation>Classifica o contrato em dentro, acima ou abaixo do justo, considerando a margem de incerteza.</bpmn:documentation>
      <bpmn:incoming>Flow_Juro_Comparar</bpmn:incoming>
      <bpmn:outgoing>Flow_Comparar_Margem</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_Margem" name="Juro fora da margem de incerteza?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Comparar_Margem</bpmn:incoming>
      <bpmn:outgoing>Flow_Margem_Nao</bpmn:outgoing>
      <bpmn:outgoing>Flow_Margem_Sim</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SemIndicio" name="Sem indício de anomalia (registrado)">
      <bpmn:incoming>Flow_Margem_Nao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Normas" name="Buscar as normas aplicáveis (RAG)">
      <bpmn:documentation>Busca semântica no pgvector em LGPD, CDC e normas do Banco Central (modo hipotético: se este contrato fosse brasileiro).</bpmn:documentation>
      <bpmn:incoming>Flow_Margem_Sim</bpmn:incoming>
      <bpmn:outgoing>Flow_Normas_Parecer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Parecer" name="Gerar o parecer em JSON (LLM)">
      <bpmn:documentation>Saída estruturada: resumo, pontos de atenção, recomendação, fontes e números citados. Fala em indício, nunca em ilegalidade.</bpmn:documentation>
      <bpmn:incoming>Flow_Normas_Parecer</bpmn:incoming>
      <bpmn:outgoing>Flow_Parecer_Conferir</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Conferir" name="Conferir os números do parecer contra a API">
      <bpmn:documentation>Cada número citado no parecer tem que ser igual ao devolvido pela API.</bpmn:documentation>
      <bpmn:incoming>Flow_Parecer_Conferir</bpmn:incoming>
      <bpmn:outgoing>Flow_Conferir_Numeros</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Numeros" name="Os números conferem?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Conferir_Numeros</bpmn:incoming>
      <bpmn:outgoing>Flow_Numeros_Sim</bpmn:outgoing>
      <bpmn:outgoing>Flow_Numeros_Nao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Template" name="Gerar o parecer pelo template de reserva (SHAP)">
      <bpmn:documentation>Texto montado por código a partir dos motivos do SHAP, sem LLM, quando os números divergem ou a API falha.</bpmn:documentation>
      <bpmn:incoming>Flow_Numeros_Nao</bpmn:incoming>
      <bpmn:outgoing>Flow_Template_Junta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Junta" gatewayDirection="Converging">
      <bpmn:incoming>Flow_Numeros_Sim</bpmn:incoming>
      <bpmn:incoming>Flow_Template_Junta</bpmn:incoming>
      <bpmn:outgoing>Flow_Junta_Revisar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Revisar" name="Revisar o parecer e as métricas">
      <bpmn:documentation>Painel do analista (Streamlit). Mostra o parecer, as métricas e, como contexto, a taxa média do mercado brasileiro no mês da concessão (série 20742 do BC).</bpmn:documentation>
      <bpmn:incoming>Flow_Junta_Revisar</bpmn:incoming>
      <bpmn:outgoing>Flow_Revisar_Decisao</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Decisao" name="Decisão do analista" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Revisar_Decisao</bpmn:incoming>
      <bpmn:outgoing>Flow_Decisao_Ajusta</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decisao_Mantem</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decisao_Compliance</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Recomendar" name="Registrar a recomendação de nova taxa">
      <bpmn:documentation>Grava a recomendação do analista. Quem reprecifica o contrato é o sistema de crédito do banco, fora deste processo.</bpmn:documentation>
      <bpmn:incoming>Flow_Decisao_Ajusta</bpmn:incoming>
      <bpmn:outgoing>Flow_Recomendar_Fim</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Recomendacao" name="Recomendação de reprecificação registrada">
      <bpmn:incoming>Flow_Recomendar_Fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Mantido" name="Preço mantido, com justificativa">
      <bpmn:incoming>Flow_Decisao_Mantem</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Compliance" name="Caso encaminhado ao Compliance">
      <bpmn:documentation>Direito de revisão (LGPD, art. 20).</bpmn:documentation>
      <bpmn:incoming>Flow_Decisao_Compliance</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_PD" sourceRef="Start_Contrato" targetRef="Task_PD" />
    <bpmn:sequenceFlow id="Flow_PD_Juro" sourceRef="Task_PD" targetRef="Task_Juro" />
    <bpmn:sequenceFlow id="Flow_Juro_Comparar" sourceRef="Task_Juro" targetRef="Task_Comparar" />
    <bpmn:sequenceFlow id="Flow_Comparar_Margem" sourceRef="Task_Comparar" targetRef="Gw_Margem" />
    <bpmn:sequenceFlow id="Flow_Margem_Nao" name="Não" sourceRef="Gw_Margem" targetRef="End_SemIndicio" />
    <bpmn:sequenceFlow id="Flow_Margem_Sim" name="Sim" sourceRef="Gw_Margem" targetRef="Task_Normas" />
    <bpmn:sequenceFlow id="Flow_Normas_Parecer" sourceRef="Task_Normas" targetRef="Task_Parecer" />
    <bpmn:sequenceFlow id="Flow_Parecer_Conferir" sourceRef="Task_Parecer" targetRef="Task_Conferir" />
    <bpmn:sequenceFlow id="Flow_Conferir_Numeros" sourceRef="Task_Conferir" targetRef="Gw_Numeros" />
    <bpmn:sequenceFlow id="Flow_Numeros_Sim" name="Sim" sourceRef="Gw_Numeros" targetRef="Gw_Junta" />
    <bpmn:sequenceFlow id="Flow_Numeros_Nao" name="Não" sourceRef="Gw_Numeros" targetRef="Task_Template" />
    <bpmn:sequenceFlow id="Flow_Template_Junta" sourceRef="Task_Template" targetRef="Gw_Junta" />
    <bpmn:sequenceFlow id="Flow_Junta_Revisar" sourceRef="Gw_Junta" targetRef="Task_Revisar" />
    <bpmn:sequenceFlow id="Flow_Revisar_Decisao" sourceRef="Task_Revisar" targetRef="Gw_Decisao" />
    <bpmn:sequenceFlow id="Flow_Decisao_Ajusta" name="Recomenda ajustar a taxa" sourceRef="Gw_Decisao" targetRef="Task_Recomendar" />
    <bpmn:sequenceFlow id="Flow_Recomendar_Fim" sourceRef="Task_Recomendar" targetRef="End_Recomendacao" />
    <bpmn:sequenceFlow id="Flow_Decisao_Mantem" name="Mantém o preço" sourceRef="Gw_Decisao" targetRef="End_Mantido" />
    <bpmn:sequenceFlow id="Flow_Decisao_Compliance" name="Encaminha ao Compliance" sourceRef="Gw_Decisao" targetRef="End_Compliance" />
    <bpmn:textAnnotation id="Anot_Normas"><bpmn:text>Normas: LGPD, CDC e Banco Central, em modo hipotético (se este contrato fosse brasileiro).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Anot_Normas" sourceRef="Anot_Normas" targetRef="Task_Normas" />
    <bpmn:textAnnotation id="Anot_Governanca"><bpmn:text>O sistema não decide sozinho: o analista decide e pode encaminhar ao Compliance (LGPD, art. 20).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Anot_Governanca" sourceRef="Anot_Governanca" targetRef="Task_Revisar" />
  </bpmn:process>
  <bpmn:process id="Process_Equidade" isExecutable="false">
    <bpmn:startEvent id="Start_Carteira" name="Carteira carregada no banco">
      <bpmn:outgoing>Flow_Carteira_Lote</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Lote" name="Calcular o juro justo de todos os contratos (lote)">
      <bpmn:incoming>Flow_Carteira_Lote</bpmn:incoming>
      <bpmn:outgoing>Flow_Lote_Equidade</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Equidade" name="Estimar a diferença de preço por gênero, idade e país (com intervalo de confiança)">
      <bpmn:documentation>Regressão da diferença de juro controlando por risco, ano, país, valor e prazo. O resultado é um indício a investigar, nunca uma conclusão. Gênero e idade só auditam.</bpmn:documentation>
      <bpmn:incoming>Flow_Lote_Equidade</bpmn:incoming>
      <bpmn:outgoing>Flow_Equidade_Gravar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Gravar" name="Gravar os resultados no banco">
      <bpmn:incoming>Flow_Equidade_Gravar</bpmn:incoming>
      <bpmn:outgoing>Flow_Gravar_Painel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Painel" name="Atualizar o painel de auditoria por grupo">
      <bpmn:incoming>Flow_Gravar_Painel</bpmn:incoming>
      <bpmn:outgoing>Flow_Painel_Fim</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Indicios" name="Indícios disponíveis ao analista e ao Compliance">
      <bpmn:incoming>Flow_Painel_Fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Carteira_Lote" sourceRef="Start_Carteira" targetRef="Task_Lote" />
    <bpmn:sequenceFlow id="Flow_Lote_Equidade" sourceRef="Task_Lote" targetRef="Task_Equidade" />
    <bpmn:sequenceFlow id="Flow_Equidade_Gravar" sourceRef="Task_Equidade" targetRef="Task_Gravar" />
    <bpmn:sequenceFlow id="Flow_Gravar_Painel" sourceRef="Task_Gravar" targetRef="Task_Painel" />
    <bpmn:sequenceFlow id="Flow_Painel_Fim" sourceRef="Task_Painel" targetRef="End_Indicios" />
    <bpmn:textAnnotation id="Anot_Genero"><bpmn:text>Gênero e idade só servem para auditar: nunca entram no modelo nem na decisão.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Anot_Genero" sourceRef="Anot_Genero" targetRef="Task_Equidade" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Auditor">
    <bpmndi:BPMNPlane id="BPMNPlane_Auditor" bpmnElement="Collaboration_Auditor">
      <bpmndi:BPMNShape id="Participant_Contrato_di" bpmnElement="Participant_Contrato" isHorizontal="true"><dc:Bounds x="160" y="80" width="2160" height="800" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Equidade_di" bpmnElement="Participant_Equidade" isHorizontal="true"><dc:Bounds x="160" y="940" width="1100" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_di" bpmnElement="Lane_Sistema" isHorizontal="true"><dc:Bounds x="190" y="80" width="2130" height="300" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IA_di" bpmnElement="Lane_IA" isHorizontal="true"><dc:Bounds x="190" y="380" width="2130" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Analista_di" bpmnElement="Lane_Analista" isHorizontal="true"><dc:Bounds x="190" y="540" width="2130" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Contrato_di" bpmnElement="Start_Contrato"><dc:Bounds x="272" y="152" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="234" y="192" width="112" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PD_di" bpmnElement="Task_PD"><dc:Bounds x="365" y="130" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Juro_di" bpmnElement="Task_Juro"><dc:Bounds x="525" y="130" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Comparar_di" bpmnElement="Task_Comparar"><dc:Bounds x="685" y="130" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Margem_di" bpmnElement="Gw_Margem" isMarkerVisible="true"><dc:Bounds x="875" y="145" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="838" y="100" width="124" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_SemIndicio_di" bpmnElement="End_SemIndicio"><dc:Bounds x="1012" y="152" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="974" y="192" width="112" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Normas_di" bpmnElement="Task_Normas"><dc:Bounds x="835" y="420" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Parecer_di" bpmnElement="Task_Parecer"><dc:Bounds x="1015" y="420" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Conferir_di" bpmnElement="Task_Conferir"><dc:Bounds x="1195" y="130" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Numeros_di" bpmnElement="Gw_Numeros" isMarkerVisible="true"><dc:Bounds x="1385" y="145" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1348" y="100" width="124" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Template_di" bpmnElement="Task_Template"><dc:Bounds x="1495" y="260" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Junta_di" bpmnElement="Gw_Junta" isMarkerVisible="true"><dc:Bounds x="1695" y="145" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Revisar_di" bpmnElement="Task_Revisar"><dc:Bounds x="1815" y="620" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Decisao_di" bpmnElement="Gw_Decisao" isMarkerVisible="true"><dc:Bounds x="2025" y="635" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1962" y="614" width="84" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Recomendar_di" bpmnElement="Task_Recomendar"><dc:Bounds x="1985" y="260" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Recomendacao_di" bpmnElement="End_Recomendacao"><dc:Bounds x="2182" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2144" y="322" width="112" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Mantido_di" bpmnElement="End_Mantido"><dc:Bounds x="2182" y="642" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2144" y="682" width="112" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Compliance_di" bpmnElement="End_Compliance"><dc:Bounds x="2182" y="762" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2144" y="802" width="112" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Carteira_di" bpmnElement="Start_Carteira"><dc:Bounds x="232" y="1072" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="194" y="1112" width="112" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Lote_di" bpmnElement="Task_Lote"><dc:Bounds x="345" y="1050" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Equidade_di" bpmnElement="Task_Equidade"><dc:Bounds x="520" y="1040" width="160" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Gravar_di" bpmnElement="Task_Gravar"><dc:Bounds x="735" y="1050" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Painel_di" bpmnElement="Task_Painel"><dc:Bounds x="905" y="1050" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Indicios_di" bpmnElement="End_Indicios"><dc:Bounds x="1102" y="1072" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1064" y="1112" width="112" height="42" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Anot_Normas_di" bpmnElement="Anot_Normas"><dc:Bounds x="350" y="428" width="300" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Anot_Governanca_di" bpmnElement="Anot_Governanca"><dc:Bounds x="1450" y="738" width="300" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Anot_Genero_di" bpmnElement="Anot_Genero"><dc:Bounds x="450" y="962" width="300" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_PD_di" bpmnElement="Flow_Start_PD"><di:waypoint x="308" y="170" /><di:waypoint x="365" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PD_Juro_di" bpmnElement="Flow_PD_Juro"><di:waypoint x="495" y="170" /><di:waypoint x="525" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Juro_Comparar_di" bpmnElement="Flow_Juro_Comparar"><di:waypoint x="655" y="170" /><di:waypoint x="685" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Comparar_Margem_di" bpmnElement="Flow_Comparar_Margem"><di:waypoint x="815" y="170" /><di:waypoint x="875" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Margem_Nao_di" bpmnElement="Flow_Margem_Nao"><di:waypoint x="925" y="170" /><di:waypoint x="1012" y="170" /><bpmndi:BPMNLabel><dc:Bounds x="940" y="148" width="30" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
